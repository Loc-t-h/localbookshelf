# Absolute path to your books. Mounted read-only.
#
# Under Docker this is the path on the Ubuntu host; compose mounts it at
# /library inside the container. Running the CLI directly, it is simply the
# folder to index. Several folders: separate with ":".
LIBRARY_PATH=/srv/books

# Port published on the host. The shelf will be at http://<server-ip>:8080
PORT=8080

TZ=America/Los_Angeles

# Files parsed in parallel during a scan. Defaults to min(8, CPU count).
# Peak scan memory is dominated by your largest files, not by this: over a
# 144-book library it measured ~390 MB at 8 workers, ~320 MB at 4, ~260 MB at
# 1, because a single 110 MB PDF alone peaks near 150 MB. Lowering this buys
# roughly 20%, not half. Serving the shelf idles near 50 MB regardless.
# EXTRACT_WORKERS=4
